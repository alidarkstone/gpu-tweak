<UserControl x:Class="GpuTweak.App.Views.TuneMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GpuTweak.App.Views">
    <!-- Live panel, part of the dashboard. DataContext is MainViewModel. -->
    <Border Style="{StaticResource Card}" Margin="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- GPU result map -->
            <StackPanel Width="260">
                <Grid>
                    <TextBlock local:Loc.Text="Test görüntüsü" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Monitor.PatternText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Border CornerRadius="10" ClipToBounds="True" Background="#FF141416">
                        <Image Source="{Binding Monitor.ErrorMap}" Width="260" Height="260" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock local:Loc.Text="Otomatik ayar başlayınca kartın çizdiği test animasyonu burada görünür" Style="{StaticResource Caption}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Foreground="{StaticResource TertiaryTextBrush}"
                               Visibility="{Binding Monitor.HasMap, Converter={x:Static local:Converters.FalseToVisible}}"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <TextBlock local:Loc.Text="Kontrol edilen hesap" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Monitor.ErrorsText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                           local:Loc.Text="Kart bu animasyonu çizerken arka planda milyonlarca hesap yapıyor ve her birinin doğruluğu kontrol ediliyor."/>
            </StackPanel>

            <!-- Live sensor charts -->
            <StackPanel Grid.Column="2">
                <TextBlock local:Loc.Text="Canlı sensörler" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock local:Loc.Text="Çekirdek" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Monitor.Clock}" FontSize="17" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8" Height="86" Padding="8">
                        <Polyline Points="{Binding Monitor.ClockPoints}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock local:Loc.Text="Sıcaklık" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Monitor.Temperature}" FontSize="17" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8" Height="86" Padding="8">
                        <Polyline Points="{Binding Monitor.TemperaturePoints}" Stroke="{StaticResource OrangeBrush}" StrokeThickness="2"/>
                    </Border>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock local:Loc.Text="Güç" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Monitor.Power}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}"><Run local:Loc.Text="Yük "/><Run Text="{Binding Monitor.Load, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="8" Height="86" Padding="8">
                        <Polyline Points="{Binding Monitor.PowerPoints}" Stroke="{StaticResource GreenBrush}" StrokeThickness="2"/>
                    </Border>
                </Grid>

                <!-- Artifact counter -->
                <Border CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#2230D158"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Monitor.ArtifactsFound, Converter={x:Static local:Converters.IsPositive}}" Value="True">
                                    <Setter Property="Background" Value="#33FF453A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel>
                            <TextBlock local:Loc.Text="Bulunan artifact" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Kartın hatalı hesap ürettiği an sayısı. Bulunan her artifact o ayarın elenmesi demek."/>
                        </StackPanel>
                        <TextBlock Text="{Binding Monitor.ArtifactsFound}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Tuning status and step results -->
            <StackPanel Grid.Column="4">
                <Grid>
                    <TextBlock Text="{Binding MonitorTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding Monitor.Elapsed}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"
                               Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
                <TextBlock Text="{Binding TuneMessage}" TextWrapping="Wrap" Style="{StaticResource Caption}" Foreground="{StaticResource TextBrush}"
                           Visibility="{Binding TuneMessage, Converter={x:Static local:Converters.NotEmptyToVisibility}}"/>
                <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding TuneProgress, Mode=OneWay}" Margin="0,10,0,0"
                             Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibility}}"/>

                <Grid Margin="0,14,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock local:Loc.Text="Ayar" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Column="1" local:Loc.Text="Sonuç" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Column="2" local:Loc.Text="Güç" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Column="3" local:Loc.Text="Sıcaklık" Style="{StaticResource Caption}"/>
                    <TextBlock Grid.Column="4" local:Loc.Text="Performans" Style="{StaticResource Caption}"/>
                </Grid>
                <TextBlock local:Loc.Text="Otomatik ayar çalışınca her denenen değer burada bir satır olarak görünür." Style="{StaticResource Caption}"
                           Foreground="{StaticResource TertiaryTextBrush}"
                           Visibility="{Binding Monitor.Steps.Count, Converter={x:Static local:Converters.ZeroToVisible}}"/>
                <ItemsControl ItemsSource="{Binding Monitor.Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Result}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Result}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Power}" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="{Binding Temperature}" FontSize="12"/>
                                <TextBlock Grid.Column="4" Text="{Binding Performance}" FontSize="12"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
