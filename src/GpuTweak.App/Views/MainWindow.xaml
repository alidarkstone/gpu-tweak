<Window x:Class="GpuTweak.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GpuTweak.App.Views"
        Title="Tweakstone" Icon="/Assets/app.ico" Width="1120" Height="800" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid x:Name="Root">
        <!-- The whole layout is designed at a fixed size and scaled to fit the window, so it never needs scrolling. -->
        <Viewbox Stretch="Uniform" VerticalAlignment="Top">
            <Grid Width="1400" Margin="28,22,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="12" Padding="12,8" Background="#1FFFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VendorName}" Foreground="{Binding Overlay.VendorBrush}" FontWeight="Bold" FontSize="15"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Info.ShortName}" Style="{StaticResource LargeTitle}"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <!-- Status messages live in the header, so they never cover the cards or the live panel. -->
                    <Border Grid.Column="2" CornerRadius="10" Padding="12,7" Margin="24,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="620"
                            Visibility="{Binding Status, Converter={x:Static local:Converters.NotEmptyToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                        <Setter Property="Background" Value="#665A3A10"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{StaticResource FillBrush}" Padding="2" Margin="0,0,16,0" VerticalAlignment="Center" ToolTip="Dil / Language">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="TR" IsChecked="{Binding IsTurkish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="tr"/>
                            <RadioButton Style="{StaticResource Segment}" Content="EN" IsChecked="{Binding IsEnglish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsMonitorVisible}" local:Loc.Content="Canlı panel" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Border CornerRadius="8" Padding="12,6" Background="#1FFFFFFF" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ActiveStateText}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>

                <!-- Live metrics -->
                <UniformGrid Grid.Row="1" Columns="6" Margin="-7,0,-7,7">
                    <UniformGrid.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Margin" Value="7,0,7,7"/>
                            <Setter Property="Padding" Value="16,14"/>
                        </Style>
                    </UniformGrid.Resources>
                    <Border>
                        <StackPanel>
                            <Grid>
                                <TextBlock local:Loc.Text="GPU sıcaklığı" Style="{StaticResource Caption}"/>
                                <Button Style="{StaticResource LinkButton}" local:Loc.Content="Sıfırla" FontSize="11" Padding="4,0" Margin="0,-3,-6,0" HorizontalAlignment="Right"
                                        Command="{Binding ResetTemperatureStatsCommand}" local:Loc.ToolTip="Min / Ort / Maks değerlerini sıfırla"/>
                            </Grid>
                            <TextBlock Text="{Binding Temperature}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding TemperatureLevel, Mode=OneWay}" Foreground="{StaticResource OrangeBrush}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding MemoryTemperature, Converter={x:Static local:Converters.NotEmptyToVisibility}}"><Run local:Loc.Text="Bellek: "/><Run Text="{Binding MemoryTemperature, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/></TextBlock>
                            <UniformGrid Columns="3" Margin="0,8,0,0" local:Loc.ToolTip="Program açıldığından (veya Sıfırla'ya basıldığından) beri">
                                <StackPanel><TextBlock Text="Min" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TemperatureMin}" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock local:Loc.Text="Ort" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TemperatureAvg}" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel><TextBlock local:Loc.Text="Maks" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TemperatureMax}" FontWeight="SemiBold"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock local:Loc.Text="Yük" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Load, Mode=OneWay}"/><Run Text=" %" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                            <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding LoadLevel, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock local:Loc.Text="Çekirdek" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding CoreClock, Mode=OneWay}"/><Run Text=" MHz" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock local:Loc.Text="Bellek" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding MemoryClock, Mode=OneWay}"/><Run Text=" MHz" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock local:Loc.Text="Güç" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Power, Mode=OneWay}"/><Run Text=" W" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                            <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding PowerLevel, Mode=OneWay}" Foreground="{StaticResource GreenBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock local:Loc.Text="VRAM · Fan" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Vram, Mode=OneWay}"/><Run Text=" GB" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                            <TextBlock Style="{StaticResource Caption}"><Run Text="Fan "/><Run Text="{Binding Fan, Mode=OneWay}"/><Run Text=" %"/></TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: automatic tuning, quick modes, overlay -->
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock local:Loc.Text="Otomatik ayar" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Caption}"
                                                   local:Loc.Text="Kartını kendisi test eder. Hedefi seç ve Başlat'a bas. Yaklaşık 20 dakika sürer; bu sırada oyun açma, bilgisayarı boşta bırak."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <Button Style="{StaticResource PillButton}" local:Loc.Content="Kaldığı yerden devam" Margin="0,0,8,0" Command="{Binding ResumeTuneCommand}"
                                                Visibility="{Binding HasPendingJournal, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Style="{StaticResource PillButton}" local:Loc.Content="Doğrulama testi" Margin="0,0,8,0" Command="{Binding StartStressCommand}"
                                                local:Loc.ToolTip="Şu anki ayarları yaklaşık 32 dakika test eder: sürekli yük, oyundaki gibi ani yük değişimleri ve voltaj eğrisinin alt noktaları. Her hesap kontrol edilir. Hata bulursa çekirdek ayarını 30 MHz düşürüp tekrar dener."
                                                Visibility="{Binding IsTuning, Converter={x:Static local:Converters.FalseToVisible}}"/>
                                        <Button Style="{StaticResource PrimaryButton}" local:Loc.Content="Başlat" Command="{Binding StartTuneCommand}"
                                                Visibility="{Binding IsTuning, Converter={x:Static local:Converters.FalseToVisible}}"/>
                                        <Button Style="{StaticResource PillButton}" local:Loc.Content="Durdur" Command="{Binding StopTuneCommand}"
                                                Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                                <Border CornerRadius="9" Background="{StaticResource FillBrush}" Padding="2" Margin="0,12,0,0" IsEnabled="{Binding CanChooseGoal}">
                                    <UniformGrid Columns="4">
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="UV tatlı nokta" IsChecked="{Binding IsGoalCool, Mode=OneWay}" Command="{Binding SetGoalCommand}" CommandParameter="Cool"/>
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="Performans" IsChecked="{Binding IsGoalPerformance, Mode=OneWay}" Command="{Binding SetGoalCommand}" CommandParameter="Performance"/>
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="Verimli" IsChecked="{Binding IsGoalEfficient, Mode=OneWay}" Command="{Binding SetGoalCommand}" CommandParameter="Efficient"/>
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="Bellek OC" IsChecked="{Binding IsGoalMemory, Mode=OneWay}" Command="{Binding SetGoalCommand}" CommandParameter="Memory"/>
                                    </UniformGrid>
                                </Border>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding GoalDescription}" Margin="0,8,0,0"/>
                                <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding TuneProgress, Mode=OneWay}" Margin="0,14,0,0"
                                             Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding TuneMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding TuneMessage, Converter={x:Static local:Converters.NotEmptyToVisibility}}"/>
                                <Border CornerRadius="10" Background="#2230D158" Padding="12,8" Margin="0,10,0,0"
                                        Visibility="{Binding HasTuneResult, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding TuneSummary}" TextWrapping="Wrap" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock local:Loc.Text="Hızlı modlar" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Sadece güç limitini değiştirir; her kartta güvenlidir."/>
                                <UniformGrid Columns="3" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PillButton}" Padding="16,10" Margin="0,0,8,0" Command="{Binding QuickModeCommand}" CommandParameter="quiet">
                                        <StackPanel><TextBlock local:Loc.Text="Sessiz" HorizontalAlignment="Center"/><TextBlock local:Loc.Text="%80 güç" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillButton}" Padding="16,10" Margin="4,0" Command="{Binding QuickModeCommand}" CommandParameter="balanced">
                                        <StackPanel><TextBlock local:Loc.Text="Dengeli" HorizontalAlignment="Center"/><TextBlock local:Loc.Text="Fabrika" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillButton}" Padding="16,10" Margin="8,0,0,0" Command="{Binding QuickModeCommand}" CommandParameter="max">
                                        <StackPanel><TextBlock local:Loc.Text="Performans" HorizontalAlignment="Center"/><TextBlock local:Loc.Text="Maks. güç" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" DataContext="{Binding Overlay}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}">
                                    <StackPanel>
                                        <TextBlock local:Loc.Text="Oyun içi widget" Style="{StaticResource SectionTitle}" Margin="0"/>
                                        <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Kısayol: Ctrl + Shift + O. Pencereli ve kenarlıksız tam ekranda görünür."/>
                                    </StackPanel>
                                </CheckBox>

                                <TextBlock local:Loc.Text="Konum" Margin="0,14,0,6"/>
                                <Border CornerRadius="9" Background="{StaticResource FillBrush}" Padding="2">
                                    <UniformGrid Columns="4" x:Name="CornerPicker">
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="Sol üst" Tag="TopLeft" Checked="OnCornerChecked"/>
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="Sağ üst" Tag="TopRight" Checked="OnCornerChecked"/>
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="Sol alt" Tag="BottomLeft" Checked="OnCornerChecked"/>
                                        <RadioButton Style="{StaticResource Segment}" local:Loc.Content="Sağ alt" Tag="BottomRight" Checked="OnCornerChecked"/>
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock local:Loc.Text="Arka plan saydamlığı"/>
                                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding Opacity, StringFormat={}{0:P0}}"/>
                                </Grid>
                                <Slider Minimum="0.2" Maximum="1" Value="{Binding Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock local:Loc.Text="Boyut"/>
                                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding Scale, StringFormat={}{0:P0}}"/>
                                </Grid>
                                <Slider Minimum="0.75" Maximum="1.5" Value="{Binding Scale}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                                <TextBlock local:Loc.Text="Gösterilecekler" Margin="0,14,0,8"/>
                                <WrapPanel>
                                    <CheckBox Style="{StaticResource Chip}" Content="Logo" IsChecked="{Binding ShowLogo}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Model" IsChecked="{Binding ShowModel}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="FPS" IsChecked="{Binding ShowFps}"/>
                                    <CheckBox Style="{StaticResource Chip}" local:Loc.Content="Yük" IsChecked="{Binding ShowLoad}"/>
                                    <CheckBox Style="{StaticResource Chip}" local:Loc.Content="Sıcaklık" IsChecked="{Binding ShowTemperature}"/>
                                    <CheckBox Style="{StaticResource Chip}" local:Loc.Content="Çekirdek" IsChecked="{Binding ShowCoreClock}"/>
                                    <CheckBox Style="{StaticResource Chip}" local:Loc.Content="Bellek" IsChecked="{Binding ShowMemoryClock}"/>
                                    <CheckBox Style="{StaticResource Chip}" local:Loc.Content="Güç" IsChecked="{Binding ShowPower}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="VRAM" IsChecked="{Binding ShowVram}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Fan" IsChecked="{Binding ShowFan}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Column 2: manual overclock / undervolt -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock local:Loc.Text="Overclock ve undervolt" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                           local:Loc.Text="Tüm değerler kartın vBIOS'unun izin verdiği aralıkla sınırlı. Voltaj hiçbir zaman fabrika değerinin üstüne çıkmaz."/>

                                <Grid>
                                    <TextBlock local:Loc.Text="Çekirdek clock offset"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource ValueBox}" local:Loc.ToolTip="Tıkla, değeri yaz ve Enter'a bas" Text="{Binding CoreOffset, Converter={x:Static local:ValueBox.Signed}, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding SupportsOffsets}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{x:Static local:ValueBox.Commit}"/></TextBox.InputBindings></TextBox><TextBlock Style="{StaticResource SettingValue}" VerticalAlignment="Center" Text=" MHz"/></StackPanel>
                                </Grid>
                                <Slider Minimum="{Binding Limits.CoreOffsetMinMHz}" Maximum="{Binding Limits.CoreOffsetMaxMHz}" Value="{Binding CoreOffset}"
                                        TickFrequency="15" IsSnapToTickEnabled="True" SmallChange="15" LargeChange="60" IsEnabled="{Binding SupportsOffsets}"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock local:Loc.Text="Bellek clock offset"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource ValueBox}" local:Loc.ToolTip="Tıkla, değeri yaz ve Enter'a bas" Text="{Binding MemoryOffset, Converter={x:Static local:ValueBox.Signed}, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding SupportsOffsets}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{x:Static local:ValueBox.Commit}"/></TextBox.InputBindings></TextBox><TextBlock Style="{StaticResource SettingValue}" VerticalAlignment="Center" Text=" MHz"/></StackPanel>
                                </Grid>
                                <Slider Minimum="{Binding Limits.MemoryOffsetMinMHz}" Maximum="{Binding Limits.MemoryOffsetMaxMHz}" Value="{Binding MemoryOffset}"
                                        TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="250" IsEnabled="{Binding SupportsOffsets}"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock local:Loc.Text="Güç limiti"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource ValueBox}" local:Loc.ToolTip="Tıkla, değeri yaz ve Enter'a bas" Text="{Binding PowerLimit, Converter={x:Static local:ValueBox.Plain}, UpdateSourceTrigger=LostFocus}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{x:Static local:ValueBox.Commit}"/></TextBox.InputBindings></TextBox><TextBlock Style="{StaticResource SettingValue}" VerticalAlignment="Center" Text=" W  "/><TextBlock Style="{StaticResource SettingValue}" VerticalAlignment="Center" Text="{Binding PowerPercentText}" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
                                </Grid>
                                <Slider Minimum="{Binding Limits.PowerMinW}" Maximum="{Binding Limits.PowerMaxW}" Value="{Binding PowerLimit}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="20"/>

                                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,18"/>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseClockCap}">
                                    <StackPanel>
                                        <TextBlock local:Loc.Text="Undervolt (max clock kilidi)"/>
                                        <TextBlock Style="{StaticResource Caption}"
                                                   local:Loc.Text="Max clock'u sabitle, sonra çekirdek offset'i artır. Kart aynı frekansa daha düşük voltajla ulaşır: daha serin, daha sessiz."/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding UseClockCap, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock local:Loc.Text="Max çekirdek clock"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource ValueBox}" local:Loc.ToolTip="Tıkla, değeri yaz ve Enter'a bas" Text="{Binding MaxClock, Converter={x:Static local:ValueBox.Plain}, UpdateSourceTrigger=LostFocus}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{x:Static local:ValueBox.Commit}"/></TextBox.InputBindings></TextBox><TextBlock Style="{StaticResource SettingValue}" VerticalAlignment="Center" Text=" MHz"/></StackPanel>
                                    </Grid>
                                    <Slider Minimum="{Binding Limits.CoreClockMinMHz}" Maximum="{Binding Limits.CoreClockMaxMHz}" Value="{Binding MaxClock}"
                                            TickFrequency="15" IsSnapToTickEnabled="True" SmallChange="15" LargeChange="60"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,18"/>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ManualFan}" IsEnabled="{Binding SupportsFanControl}">
                                    <StackPanel>
                                        <TextBlock local:Loc.Text="Manuel fan hızı"/>
                                        <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Kapalıyken fanları sürücü yönetir (önerilen)."/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding ManualFan, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock Text="Fan"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource ValueBox}" local:Loc.ToolTip="Tıkla, değeri yaz ve Enter'a bas" Text="{Binding FanPercent, Converter={x:Static local:ValueBox.Plain}, UpdateSourceTrigger=LostFocus}"><TextBox.InputBindings><KeyBinding Key="Return" Command="{x:Static local:ValueBox.Commit}"/></TextBox.InputBindings></TextBox><TextBlock Style="{StaticResource SettingValue}" VerticalAlignment="Center" Text=" %"/></StackPanel>
                                    </Grid>
                                    <Slider Minimum="{Binding Limits.FanMinPercent}" Maximum="{Binding Limits.FanMaxPercent}" Value="{Binding FanPercent}"
                                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Style="{StaticResource PillButton}" local:Loc.Content="Varsayılana dön" Command="{Binding ResetCommand}" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" local:Loc.Content="Uygula" Command="{Binding ApplyCommand}" MinWidth="110"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Game stability: problems seen in real games, tied to the settings that were on -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock local:Loc.Text="Oyun kararlılığı" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center"><Run local:Loc.Text="Şu an: "/><Run Text="{Binding Stability.CurrentGame, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/></TextBlock>
                                </Grid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,12"
                                           local:Loc.Text="Oyun oynarken Windows kayıtlarını izler. Sürücü çökmesi, oyun çökmesi veya mavi ekran olursa ayarı bir adım geri çeker."/>

                                <UniformGrid Columns="3" Margin="-5,0,-5,0">
                                    <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Sorunsuz oyun"/>
                                            <TextBlock Text="{Binding Stability.CleanTime}" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="10" Padding="12,8" Margin="5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2230D158"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stability.IncidentCount, Converter={x:Static local:Converters.IsPositive}}" Value="True">
                                                        <Setter Property="Background" Value="#33FF453A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Algılanan sorun"/>
                                            <TextBlock Text="{Binding Stability.IncidentCount}" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Oyun oturumu"/>
                                            <TextBlock Text="{Binding Stability.SessionCount}" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding Stability.CleanLevel, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" Margin="0,12,0,0"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Stability.CleanGoal}" Margin="0,4,0,0"/>
                                <Button Style="{StaticResource PrimaryButton}" local:Loc.Content="Profili &quot;Stabil&quot; işaretle" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding MarkStableCommand}" Visibility="{Binding CanMarkStable, Converter={StaticResource BoolToVisibility}}"/>

                                <ItemsControl ItemsSource="{Binding Stability.Recent}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,0,0,3">
                                                <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource TertiaryTextBrush}"/><Run Text="   "/><Run Text="{Binding Text, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource OrangeBrush}" Text="{Binding Stability.LastChange}"
                                           Visibility="{Binding Stability.LastChange, Converter={x:Static local:Converters.NotEmptyToVisibility}}"/>
                                <StackPanel Visibility="{Binding Stability.CanUndo, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" local:Loc.Text="Sorun ayarlardan kaynaklanmadıysa (başka bir program, elektrik kesintisi) son düzeltmeyi geri alabilirsin."/>
                                    <Button Style="{StaticResource PillButton}" Background="#33FFFFFF" Foreground="White" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            local:Loc.Content="Son düzeltmeyi geri al" Command="{Binding UndoStabilityCommand}"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,14"/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoFixStability}">
                                    <StackPanel>
                                        <TextBlock local:Loc.Text="Sorun olunca otomatik düzelt"/>
                                        <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Kapalıyken sadece kaydeder ve öneri gösterir."/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               local:Loc.Text="Oyunda titreyen doku, renkli nokta veya çizgi gördüysen bas. Oyun içindeyken Ctrl+Shift+A da olur."/>
                                    <Button Grid.Column="1" Style="{StaticResource PillButton}" local:Loc.Content="Artifact gördüm" Command="{Binding ReportArtifactCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Column 3: profiles and community suggestions -->
                    <StackPanel Grid.Column="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock local:Loc.Text="Profillerim" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Sadece stabil işaretlenen profiller açılışta otomatik uygulanabilir."/>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock local:Loc.Text="Windows ile başlat"/>
                                        <TextBlock Style="{StaticResource Caption}"
                                                   local:Loc.Text="Bilgisayar açılınca program saatin yanındaki simgede gizli başlar ve &quot;Otomatik: açık&quot; profili yeniden uygular. Ekran kartı ayarları her yeniden başlatmada sıfırlandığı için gerekli."/>
                                    </StackPanel>
                                </CheckBox>
                                <Button Style="{StaticResource LinkButton}" local:Loc.Content="Ayarların kaydedildiği klasörü aç" HorizontalAlignment="Left" Margin="-6,6,0,0"
                                        Command="{Binding OpenDataFolderCommand}" ToolTip="{Binding DataFolder}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{StaticResource TertiaryTextBrush}"
                                           local:Loc.Text="Henüz kayıtlı profil yok. Ayarları yap, aşağıya bir ad yaz ve kaydet; profil burada bir satır olarak görünür ve tek tıkla geri uygulanır."
                                           Visibility="{Binding HasProfiles, Converter={x:Static local:Converters.FalseToVisible}}"/>
                                <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Style="{StaticResource Caption}">
                                                            <Run Text="{local:T Çekirdek}"/><Run Text=" "/><Run Text="{Binding Settings.CoreOffsetMHz, Mode=OneWay, StringFormat={}{0:+0;-0;0}}"/><Run Text=" · "/><Run Text="{local:T Bellek}"/><Run Text=" "/><Run Text="{Binding Settings.MemoryOffsetMHz, Mode=OneWay, StringFormat={}{0:+0;-0;0}}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource LinkButton}" local:Loc.Content="Uygula" local:Loc.ToolTip="Bu profili karta uygula (15 saniye içinde onay istenir)"
                                                                Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Command="{Binding DataContext.ToggleStableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
>
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                                    <Setter Property="Content" Value="{local:T 'Stabil işaretle'}"/>
                                                                    <Setter Property="ToolTip" Value="{local:T 'Oyunlarda sorunsuz çalıştıysa tıkla, profil stabil olarak işaretlenir'}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsStable}" Value="True">
                                                                            <Setter Property="Content" Value="{local:T '✓ Stabil'}"/>
                                                                            <Setter Property="ToolTip" Value="{local:T 'Bu profil stabil olarak işaretli. İşareti kaldırmak için tıkla'}"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.ToggleAutoApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                local:Loc.ToolTip="Uygulama açılınca bu profili uygula">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                                    <Setter Property="Content" Value="{local:T 'Otomatik: kapalı'}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AutoApplyOnStart}" Value="True">
                                                                            <Setter Property="Content" Value="{local:T 'Otomatik: açık'}"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Style="{StaticResource LinkButton}" local:Loc.Content="Sil" Foreground="{StaticResource RedBrush}"
                                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="ProfileNameBox" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" local:Loc.ToolTip="Profil adı"/>
                                        <TextBlock local:Loc.Text="Profil adı yaz…" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TertiaryTextBrush}"
                                                   Visibility="{Binding NewProfileName, Converter={x:Static local:Converters.EmptyToVisibility}}"/>
                                    </Grid>
                                    <Button Grid.Column="1" Style="{StaticResource PillButton}" local:Loc.Content="Mevcut ayarları kaydet" Margin="8,0,0,0" Command="{Binding SaveProfileCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Silicon: what the auto-tune measured on this chip -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock local:Loc.Text="Silikon skoru" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding SiliconText}" Margin="0,0,0,0"/>
                                <UniformGrid Columns="3" Margin="-5,12,-5,0" Visibility="{Binding HasSilicon, Converter={StaticResource BoolToVisibility}}">
                                    <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Testte kaldırdı"/>
                                            <TextBlock Text="{Binding SiliconHeadroom}" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Günlük ayar"/>
                                            <TextBlock Text="{Binding SiliconDaily}" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Oyunda kararlı"/>
                                            <TextBlock Text="{Binding SiliconGame}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock local:Loc.Text="Topluluk önerileri" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" local:Loc.Text="Her öneri kaynağıyla birlikte gelir ve önce yarı güçte yüklenir. Her çip farklıdır; başlangıç noktası olarak kullan."/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{StaticResource TertiaryTextBrush}"
                                           local:Loc.Text="Bu model için henüz kaynaklı bir öneri yok."
                                           Visibility="{Binding HasSuggestions, Converter={x:Static local:Converters.FalseToVisible}}"/>
                                <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceTitle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource LinkButton}" local:Loc.Content="Kaynak"
                                                                Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource LinkButton}" local:Loc.Content="Yükle"
                                                                Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Live panel: sensors, GPU result map and auto-tune steps. Visible by default, hidden with the header switch. -->
                <local:TuneMonitorView Grid.Row="3" Margin="0,0,0,0"
                                       Visibility="{Binding IsMonitorVisible, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Viewbox>

        <!-- Bottom area: confirmation banner -->
        <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,20">

            <Border CornerRadius="16" Padding="18,12" Background="#F20A84FF" MaxWidth="760"
                    Visibility="{Binding IsConfirmPending, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock local:Loc.Text="Yeni ayarlar her şey yolunda mı?" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Foreground="#DDFFFFFF" FontSize="12"><Run local:Loc.Text="Onaylamazsan "/><Run Text="{Binding Countdown, Mode=OneWay}" FontWeight="SemiBold"/><Run local:Loc.Text=" saniye içinde otomatik geri alınacak."/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PillButton}" Background="#33FFFFFF" Foreground="White" local:Loc.Content="Geri al" Command="{Binding RevertCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PillButton}" Background="White" Foreground="#FF0A84FF" local:Loc.Content="Koru" Command="{Binding ConfirmCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
