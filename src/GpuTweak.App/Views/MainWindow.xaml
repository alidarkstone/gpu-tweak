<Window x:Class="GpuTweak.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GpuTweak.App.Views"
        Title="GPU Tweak" Width="1120" Height="800" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid x:Name="Root">
        <!-- The whole layout is designed at a fixed size and scaled to fit the window, so it never needs scrolling. -->
        <Viewbox Stretch="Uniform" VerticalAlignment="Top">
            <Grid Width="1400" Margin="28,22,28,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="12" Padding="12,8" Background="#1FFFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VendorName}" Foreground="{Binding Overlay.VendorBrush}" FontWeight="Bold" FontSize="15"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Info.ShortName}" Style="{StaticResource LargeTitle}"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="8" Padding="12,6" Background="#1FFFFFFF" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ActiveStateText}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Live metrics -->
                <UniformGrid Grid.Row="1" Columns="6" Margin="-7,0,-7,7">
                    <UniformGrid.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Margin" Value="7,0,7,7"/>
                            <Setter Property="Padding" Value="16,14"/>
                        </Style>
                    </UniformGrid.Resources>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="Sıcaklık" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Temperature}" Style="{StaticResource MetricValue}"/>
                            <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding TemperatureLevel, Mode=OneWay}" Foreground="{StaticResource OrangeBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="Yük" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Load, Mode=OneWay}"/><Run Text=" %" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                            <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding LoadLevel, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="Çekirdek" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding CoreClock, Mode=OneWay}"/><Run Text=" MHz" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="Bellek" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding MemoryClock, Mode=OneWay}"/><Run Text=" MHz" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="Güç" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Power, Mode=OneWay}"/><Run Text=" W" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                            <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding PowerLevel, Mode=OneWay}" Foreground="{StaticResource GreenBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="VRAM · Fan" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource MetricValue}"><Run Text="{Binding Vram, Mode=OneWay}"/><Run Text=" GB" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                            <TextBlock Style="{StaticResource Caption}"><Run Text="Fan "/><Run Text="{Binding Fan, Mode=OneWay}"/><Run Text=" %"/></TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: automatic tuning, quick modes, overlay -->
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Otomatik ayar" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="Kartını kendisi test eder ve FPS kaybetmeden en düşük voltajlı, en serin ayarı bulur. Yaklaşık 20 dakika sürer; bu sırada oyun açma, bilgisayarı boşta bırak."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <Button Style="{StaticResource PillButton}" Content="Kaldığı yerden devam" Margin="0,0,8,0" Command="{Binding ResumeTuneCommand}"
                                                Visibility="{Binding HasPendingJournal, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Başlat" Command="{Binding StartTuneCommand}"
                                                Visibility="{Binding IsTuning, Converter={x:Static local:Converters.FalseToVisible}}"/>
                                        <Button Style="{StaticResource PillButton}" Content="Durdur" Command="{Binding StopTuneCommand}"
                                                Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding TuneProgress, Mode=OneWay}" Margin="0,14,0,0"
                                             Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding TuneMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding TuneMessage, Converter={x:Static local:Converters.NotEmptyToVisibility}}"/>
                                <Border CornerRadius="10" Background="#2230D158" Padding="12,8" Margin="0,10,0,0"
                                        Visibility="{Binding HasTuneResult, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding TuneSummary}" TextWrapping="Wrap" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Hızlı modlar" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Sadece güç limitini değiştirir; her kartta güvenlidir."/>
                                <UniformGrid Columns="3" Margin="0,12,0,0">
                                    <Button Style="{StaticResource PillButton}" Padding="16,10" Margin="0,0,8,0" Command="{Binding QuickModeCommand}" CommandParameter="quiet">
                                        <StackPanel><TextBlock Text="Sessiz" HorizontalAlignment="Center"/><TextBlock Text="%80 güç" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillButton}" Padding="16,10" Margin="4,0" Command="{Binding QuickModeCommand}" CommandParameter="balanced">
                                        <StackPanel><TextBlock Text="Dengeli" HorizontalAlignment="Center"/><TextBlock Text="Fabrika" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillButton}" Padding="16,10" Margin="8,0,0,0" Command="{Binding QuickModeCommand}" CommandParameter="max">
                                        <StackPanel><TextBlock Text="Performans" HorizontalAlignment="Center"/><TextBlock Text="Maks. güç" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" DataContext="{Binding Overlay}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}">
                                    <StackPanel>
                                        <TextBlock Text="Oyun içi widget" Style="{StaticResource SectionTitle}" Margin="0"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Kısayol: Ctrl + Shift + O. Pencereli ve kenarlıksız tam ekranda görünür."/>
                                    </StackPanel>
                                </CheckBox>

                                <TextBlock Text="Konum" Margin="0,14,0,6"/>
                                <Border CornerRadius="9" Background="{StaticResource FillBrush}" Padding="2">
                                    <UniformGrid Columns="4" x:Name="CornerPicker">
                                        <RadioButton Style="{StaticResource Segment}" Content="Sol üst" Tag="TopLeft" Checked="OnCornerChecked"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Sağ üst" Tag="TopRight" Checked="OnCornerChecked"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Sol alt" Tag="BottomLeft" Checked="OnCornerChecked"/>
                                        <RadioButton Style="{StaticResource Segment}" Content="Sağ alt" Tag="BottomRight" Checked="OnCornerChecked"/>
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Arka plan saydamlığı"/>
                                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding Opacity, StringFormat={}{0:P0}}"/>
                                </Grid>
                                <Slider Minimum="0.2" Maximum="1" Value="{Binding Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Boyut"/>
                                    <TextBlock Style="{StaticResource SettingValue}" Text="{Binding Scale, StringFormat={}{0:P0}}"/>
                                </Grid>
                                <Slider Minimum="0.75" Maximum="1.5" Value="{Binding Scale}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                                <TextBlock Text="Gösterilecekler" Margin="0,14,0,8"/>
                                <WrapPanel>
                                    <CheckBox Style="{StaticResource Chip}" Content="Logo" IsChecked="{Binding ShowLogo}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Model" IsChecked="{Binding ShowModel}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Yük" IsChecked="{Binding ShowLoad}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Sıcaklık" IsChecked="{Binding ShowTemperature}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Çekirdek" IsChecked="{Binding ShowCoreClock}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Bellek" IsChecked="{Binding ShowMemoryClock}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Güç" IsChecked="{Binding ShowPower}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="VRAM" IsChecked="{Binding ShowVram}"/>
                                    <CheckBox Style="{StaticResource Chip}" Content="Fan" IsChecked="{Binding ShowFan}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Column 2: manual overclock / undervolt -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Overclock ve undervolt" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14"
                                           Text="Tüm değerler kartın vBIOS'unun izin verdiği aralıkla sınırlı. Voltaj hiçbir zaman fabrika değerinin üstüne çıkmaz."/>

                                <Grid>
                                    <TextBlock Text="Çekirdek clock offset"/>
                                    <TextBlock Style="{StaticResource SettingValue}"><Run Text="{Binding CoreOffset, Mode=OneWay, StringFormat={}{0:+0;-0;0}}"/><Run Text=" MHz"/></TextBlock>
                                </Grid>
                                <Slider Minimum="{Binding Limits.CoreOffsetMinMHz}" Maximum="{Binding Limits.CoreOffsetMaxMHz}" Value="{Binding CoreOffset}"
                                        TickFrequency="15" IsSnapToTickEnabled="True" SmallChange="15" LargeChange="60" IsEnabled="{Binding SupportsOffsets}"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Bellek clock offset"/>
                                    <TextBlock Style="{StaticResource SettingValue}"><Run Text="{Binding MemoryOffset, Mode=OneWay, StringFormat={}{0:+0;-0;0}}"/><Run Text=" MHz"/></TextBlock>
                                </Grid>
                                <Slider Minimum="{Binding Limits.MemoryOffsetMinMHz}" Maximum="{Binding Limits.MemoryOffsetMaxMHz}" Value="{Binding MemoryOffset}"
                                        TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="250" IsEnabled="{Binding SupportsOffsets}"/>

                                <Grid Margin="0,14,0,0">
                                    <TextBlock Text="Güç limiti"/>
                                    <TextBlock Style="{StaticResource SettingValue}"><Run Text="{Binding PowerLimit, Mode=OneWay}"/><Run Text=" W  "/><Run Text="{Binding PowerPercentText, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}"/></TextBlock>
                                </Grid>
                                <Slider Minimum="{Binding Limits.PowerMinW}" Maximum="{Binding Limits.PowerMaxW}" Value="{Binding PowerLimit}"
                                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="20"/>

                                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,18"/>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseClockCap}">
                                    <StackPanel>
                                        <TextBlock Text="Undervolt (max clock kilidi)"/>
                                        <TextBlock Style="{StaticResource Caption}"
                                                   Text="Max clock'u sabitle, sonra çekirdek offset'i artır. Kart aynı frekansa daha düşük voltajla ulaşır: daha serin, daha sessiz."/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding UseClockCap, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock Text="Max çekirdek clock"/>
                                        <TextBlock Style="{StaticResource SettingValue}"><Run Text="{Binding MaxClock, Mode=OneWay}"/><Run Text=" MHz"/></TextBlock>
                                    </Grid>
                                    <Slider Minimum="{Binding Limits.CoreClockMinMHz}" Maximum="{Binding Limits.CoreClockMaxMHz}" Value="{Binding MaxClock}"
                                            TickFrequency="15" IsSnapToTickEnabled="True" SmallChange="15" LargeChange="60"/>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="0,18"/>

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ManualFan}" IsEnabled="{Binding SupportsFanControl}">
                                    <StackPanel>
                                        <TextBlock Text="Manuel fan hızı"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Kapalıyken fanları sürücü yönetir (önerilen)."/>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding ManualFan, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                                    <Grid>
                                        <TextBlock Text="Fan"/>
                                        <TextBlock Style="{StaticResource SettingValue}"><Run Text="{Binding FanPercent, Mode=OneWay}"/><Run Text=" %"/></TextBlock>
                                    </Grid>
                                    <Slider Minimum="{Binding Limits.FanMinPercent}" Maximum="{Binding Limits.FanMaxPercent}" Value="{Binding FanPercent}"
                                            TickFrequency="5" IsSnapToTickEnabled="True"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Style="{StaticResource PillButton}" Content="Varsayılana dön" Command="{Binding ResetCommand}" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Uygula" Command="{Binding ApplyCommand}" MinWidth="110"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Column 3: profiles and community suggestions -->
                    <StackPanel Grid.Column="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Profillerim" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Sadece stabil işaretlenen profiller açılışta otomatik uygulanabilir."/>
                                <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Style="{StaticResource Caption}">
                                                            <Run Text="{Binding Settings.CoreOffsetMHz, Mode=OneWay, StringFormat='Çekirdek {0:+0;-0;0}'}"/><Run Text=" · "/><Run Text="{Binding Settings.MemoryOffsetMHz, Mode=OneWay, StringFormat='Bellek {0:+0;-0;0}'}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource LinkButton}" Content="Yükle"
                                                                Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Command="{Binding DataContext.ToggleStableCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                ToolTip="Oyunlarda test ettikten sonra stabil olarak işaretle">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                                    <Setter Property="Content" Value="Stabil değil"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsStable}" Value="True">
                                                                            <Setter Property="Content" Value="✓ Stabil"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.ToggleAutoApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                ToolTip="Uygulama açılınca bu profili uygula">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                                    <Setter Property="Content" Value="Otomatik: kapalı"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AutoApplyOnStart}" Value="True">
                                                                            <Setter Property="Content" Value="Otomatik: açık"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Style="{StaticResource LinkButton}" Content="Sil" Foreground="{StaticResource RedBrush}"
                                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Profil adı"/>
                                    <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Mevcut ayarları kaydet" Margin="8,0,0,0" Command="{Binding SaveProfileCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Topluluk önerileri" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Her öneri kaynağıyla birlikte gelir ve önce yarı güçte yüklenir. Her çip farklıdır; başlangıç noktası olarak kullan."/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{StaticResource TertiaryTextBrush}"
                                           Text="Bu model için henüz kaynaklı bir öneri yok."
                                           Visibility="{Binding HasSuggestions, Converter={x:Static local:Converters.FalseToVisible}}"/>
                                <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Background="{StaticResource FillBrush}" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceTitle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource LinkButton}" Content="Kaynak"
                                                                Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource LinkButton}" Content="Yükle"
                                                                Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Bottom area: status toast and confirmation banner -->
        <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,20">
            <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,10" MaxWidth="760"
                    Visibility="{Binding Status, Converter={x:Static local:Converters.NotEmptyToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F23A3A3C"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                                <Setter Property="Background" Value="#F25A3A10"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </Border>

            <Border CornerRadius="16" Padding="18,12" Background="#F20A84FF" MaxWidth="760"
                    Visibility="{Binding IsConfirmPending, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yeni ayarlar her şey yolunda mı?" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Foreground="#DDFFFFFF" FontSize="12"><Run Text="Onaylamazsan "/><Run Text="{Binding Countdown, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" saniye içinde otomatik geri alınacak."/></TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PillButton}" Background="#33FFFFFF" Foreground="White" Content="Geri al" Command="{Binding RevertCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PillButton}" Background="White" Foreground="#FF0A84FF" Content="Koru" Command="{Binding ConfirmCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
